<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="30051ed3-869d-4694-ac86-d5913c9d42bd">
    <mxGraphModel dx="1338" dy="1550" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;: &quot;@startuml
skinparam componentStyle rectangle
skinparam DefaultFontSize 15
skinparam ArrowFontSize 12
skinparam nodesep 25
skinparam ranksep 50

package \&quot;Client Tier\&quot; {
  [Browser (React SPA)] as Browser
}

package \&quot;Edge Tier\&quot; {
  [Nginx] as Nginx
}

package \&quot;API Gateway Tier\&quot; {
  [API Gateway\n(Spring Cloud Gateway)] as Gateway
}

package \&quot;Microservices Tier\&quot; {
  [Auth Service\n(Spring Boot)] as Auth
  [Decision Service\n(Spring Boot)] as Decision
  [Document Service\n(Spring Boot)] as Document
  [GenAI Service\n(Python/FastAPI)] as GenAI
  [Simulation Service\n(Python/FastAPI)] as Simulation

  Auth -[hidden]right-&gt; Decision
  Decision -[hidden]right-&gt; Document
  Document -[hidden]right-&gt; GenAI
  GenAI -[hidden]right-&gt; Simulation
}

package \&quot;Data &amp; Infrastructure Tier\&quot; {
  database \&quot;auth_db\n(PostgreSQL)\&quot; as AuthDB
  database \&quot;decision_db\n(PostgreSQL)\&quot; as DecisionDB
  database \&quot;document_db\n(PostgreSQL)\&quot; as DocumentDB
  queue \&quot;Apache Kafka\&quot; as Kafka
  storage \&quot;MinIO\n(Object Storage)\&quot; as MinIO
  database \&quot;ChromaDB\n(Vector Store)\&quot; as Chroma
  database \&quot;Redis\&quot; as Redis

  AuthDB -[hidden]right-&gt; DecisionDB
  DecisionDB -[hidden]right-&gt; DocumentDB
  DocumentDB -[hidden]right-&gt; Kafka
  Kafka -[hidden]right-&gt; MinIO
  MinIO -[hidden]right-&gt; Chroma
  Chroma -[hidden]right-&gt; Redis
}

Browser --&gt; Nginx : HTTPS
Nginx --&gt; Gateway : /api/*

Gateway --&gt; Auth : \&quot;/auth/**\&quot;
Gateway --&gt; Decision : \&quot;/decisions/**\&quot;
Gateway --&gt; Document : \&quot;/documents/**\&quot;
Gateway --&gt; GenAI : \&quot;/ai/**\&quot;
Gateway --&gt; Simulation : \&quot;/simulations/**\&quot;
Gateway --&gt; Redis : rate limiting

Auth --&gt; AuthDB
Decision --&gt; DecisionDB
Document --&gt; DocumentDB
Document --&gt; MinIO
Document --&gt; Kafka : \&quot;document.uploaded\&quot;

Kafka --&gt; GenAI : consume
GenAI --&gt; MinIO : fetch file
GenAI --&gt; Chroma
GenAI --&gt; Kafka : \&quot;extraction.completed\&quot;
Kafka --&gt; Decision : consume

Simulation --&gt; Decision
Simulation --&gt; DecisionDB

' pin every microservice above the full width of the data tier
Auth -[hidden]-&gt; AuthDB
Decision -[hidden]-&gt; DecisionDB
Document -[hidden]-&gt; DocumentDB
GenAI -[hidden]-&gt; Chroma
GenAI -[hidden]-&gt; Kafka
Simulation -[hidden]-&gt; Redis
Auth -[hidden]-&gt; Redis
Simulation -[hidden]-&gt; MinIO

@enduml
&quot;, &quot;format&quot;: &quot;svg&quot;}" id="obj-ea09d7f3-7ff5-4c3a-9916-b0ef1710e435">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;imageAspect=0;image=data:image/svg+xml,;aspect=fixed;" vertex="1">
            <mxGeometry height="811" width="1721" x="40" y="40" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
